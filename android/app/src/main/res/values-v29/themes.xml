<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 10 and later: the system must not darken the app behind its back either (light only, founder 2026-10-15). -->
    <style name="Theme.Numbite" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>

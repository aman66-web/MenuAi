<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone by backup or device transfer: the sign-in (a Keystore key only this phone holds, and what it encrypted), the reminders (a person's
     own words and times) and the web app's saved data are all this phone's alone (founder rule: privacy). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only (founder 2026-10-15: no dark mode). The launch screen is the system splash (Android 12+, backported by core-splashscreen). -->
    <style name="Theme.Numbite.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Numbite</item>
    </style>

    <style name="Theme.Numbite" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

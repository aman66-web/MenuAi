# Copy to .env.local for local development. In Vercel, add the same names under
# Project › Settings › Environment Variables (Production and Preview).

# Supabase › Project Settings › API (Data API URL) and API Keys › Secret key (sb_secret_...).
# The secret key bypasses all security rules: server only, never in the app or browser, never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Any long random string (e.g. `openssl rand -hex 32`). Used to hash IP addresses for rate limiting.
IP_HASH_SALT=replace-with-a-long-random-string

# Any long random string. Vercel sends it to the daily cleanup job automatically.
CRON_SECRET=replace-with-another-long-random-string

# Pip's recipe maker (optional): an Anthropic API key from console.anthropic.com › API Keys. Server only, never in the app or browser.
# Without it, Recipes still work and the recipe maker says it isn't switched on. Set a monthly spend limit in the Anthropic console.
ANTHROPIC_API_KEY=

# Community reports alert (optional, all three together): the daily cleanup emails a COUNT ONLY (never a name or any words) while a Community report is open.
# Create a Resend API key restricted to sending from your domain. Server only. Without them nothing is sent (docs/BACKEND.md "Community").
RESEND_API_KEY=
REPORT_ALERT_TO=
REPORT_ALERT_FROM=Numbite <alerts@your-domain.com>

# Public settings (safe to expose)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# Set after launch to swap the waitlist for an App Store button:
NEXT_PUBLIC_APP_STORE_URL=

# ---- Paid access on the website (docs/PAYMENTS.md). All off until you set them; with any missing the payment routes just answer 503 ("not available").
# Stripe > Developers > API keys (a restricted key that can create Checkout Sessions and read them is enough). Server only.
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint https://numbite.com/api/v1/webhook/stripe > Signing secret (whsec_...). Server only.
STRIPE_WEBHOOK_SECRET=
# The three Stripe Price ids (price_...): GBP 9.99 one-time, GBP 14.99 every year, GBP 2.99 every month.
STRIPE_PRICE_PASS90=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=
# Made by `node tools/payments/make_entitlement_key.mjs` on your own computer. The private one is secret and server only.
ENTITLEMENT_PRIVATE_JWK=
NEXT_PUBLIC_ENTITLEMENT_PUBLIC_JWK=
# Set to 1 (in Vercel, then redeploy) only when everything above works in Stripe's test mode: shows the plans and turns on the free tier.
NEXT_PUBLIC_WEB_PRO=

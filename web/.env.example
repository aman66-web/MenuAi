# Copy to .env.local for local development. In Vercel, add the same names under
# Project › Settings › Environment Variables (Production and Preview).

# Supabase › Project Settings › API (Data API URL) and API Keys › Secret key (sb_secret_...).
# The secret key bypasses all security rules: server only, never in the app or browser, never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Any long random string (e.g. `openssl rand -hex 32`). Used to hash IP addresses for rate limiting.
IP_HASH_SALT=replace-with-a-long-random-string

# Any long random string. Vercel sends it to the daily cleanup job automatically.
CRON_SECRET=replace-with-another-long-random-string

# Public settings (safe to expose)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# Set after launch to swap the waitlist for an App Store button:
NEXT_PUBLIC_APP_STORE_URL=

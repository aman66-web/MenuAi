{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menumacros.app/schema/chain.schema.json",
  "title": "MenuMacros chain menu file (chain-<id>.json)",
  "description": "One restaurant chain's full menu. Produced by tools/build_menus.py; read by the iOS app. See docs/DATA.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "cuisine",
    "builderType",
    "aliases",
    "sample",
    "source",
    "categories",
    "components",
    "items",
    "combinations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cuisine": {
      "type": "string"
    },
    "builderType": {
      "enum": [
        "build_your_own",
        "standard"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lower-case names used to match Apple Maps results to this chain."
    },
    "sample": {
      "type": "boolean",
      "description": "true = fictional sample data. The app must hide sample chains in Release builds."
    },
    "note": {
      "type": "string",
      "description": "Optional. A limit of the chain's published data that users should know (shown under the source on the chain page), e.g. which parts of an order the numbers cover."
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "checkedOn"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "checkedOn": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Menu categories in display order."
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/combination"
      }
    },
    "allergenGuide": {
      "type": "object",
      "required": [
        "title",
        "url",
        "checkedOn",
        "mayContainPublished",
        "complete"
      ],
      "additionalProperties": false,
      "description": "Optional. The chain's own allergen guide. complete=false: the guide couldn't be read completely, so no item carries allergens and the app only links to the guide.",
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "checkedOn": {
          "$ref": "#/$defs/date"
        },
        "mayContainPublished": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "vegetarian",
          "contains_pork",
          "contains_beef"
        ]
      }
    },
    "nutrients": {
      "type": "object",
      "description": "calories in kcal; protein/carbs/fat/saturatedFat/sugar/fiber in grams; sodium in mg, salt in g (UK guides publish salt, not sodium). Optional keys are OMITTED when not published (never estimated).",
      "required": [
        "calories",
        "protein",
        "carbs",
        "fat"
      ],
      "additionalProperties": false,
      "properties": {
        "calories": {
          "type": "integer",
          "minimum": 0
        },
        "protein": {
          "type": "number",
          "minimum": 0
        },
        "carbs": {
          "type": "number",
          "minimum": 0
        },
        "fat": {
          "type": "number",
          "minimum": 0
        },
        "saturatedFat": {
          "type": "number",
          "minimum": 0
        },
        "sodium": {
          "type": "integer",
          "minimum": 0
        },
        "sugar": {
          "type": "number",
          "minimum": 0
        },
        "fiber": {
          "type": "number",
          "minimum": 0
        },
        "salt": {
          "type": "number",
          "minimum": 0
        },
        "energyKj": {
          "type": "number",
          "minimum": 0,
          "description": "Energy in kJ per serving as printed (never converted from kcal)."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Serving weight in grams as printed."
        },
        "monounsaturatedFat": {
          "type": "number",
          "minimum": 0,
          "description": "g"
        },
        "polyunsaturatedFat": {
          "type": "number",
          "minimum": 0,
          "description": "g"
        },
        "transFat": {
          "type": "number",
          "minimum": 0,
          "description": "g"
        },
        "caffeine": {
          "type": "number",
          "minimum": 0,
          "description": "mg as printed"
        }
      }
    },
    "componentRef": {
      "type": "object",
      "required": [
        "id",
        "qty"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "qty": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "group",
        "name",
        "portion",
        "nutrients",
        "tags",
        "removable",
        "allowDouble"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "group": {
          "enum": [
            "base",
            "wrap",
            "protein",
            "topping",
            "sauce",
            "side",
            "drink",
            "extra"
          ]
        },
        "name": {
          "type": "string"
        },
        "portion": {
          "type": "string"
        },
        "nutrients": {
          "$ref": "#/$defs/nutrients"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "removable": {
          "type": "boolean"
        },
        "allowDouble": {
          "type": "boolean"
        },
        "allergens": {
          "$ref": "#/$defs/allergens"
        }
      }
    },
    "modifier": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "nutrients",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "remove",
            "add"
          ]
        },
        "nutrients": {
          "$ref": "#/$defs/nutrients",
          "description": "The published nutrition of the ingredient itself (positive). kind decides whether it is subtracted or added."
        },
        "tags": {
          "$ref": "#/$defs/tags",
          "description": "Tags this ingredient adds (add modifiers only), e.g. contains_pork for bacon."
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "serving",
        "nutrients",
        "tags",
        "limitedTime",
        "rankable",
        "components",
        "modifiers"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "serving": {
          "type": "string"
        },
        "nutrients": {
          "$ref": "#/$defs/nutrients"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "limitedTime": {
          "type": "boolean"
        },
        "rankable": {
          "type": "boolean",
          "description": "false = never a 'Best for you' candidate (drinks, sauces, treats)."
        },
        "addedOn": {
          "$ref": "#/$defs/date"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentRef"
          },
          "description": "Build-your-own items only: the default recipe. Empty for standard items."
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          },
          "description": "Standard items only: published add/remove options."
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*\\.webp$",
          "description": "Optional. The chain's own photo of this item: '<chain-id>/<file>.webp', served from /menu-images/ (docs/DATA.md images.csv)."
        },
        "allergens": {
          "$ref": "#/$defs/allergens"
        }
      }
    },
    "combination": {
      "type": "object",
      "description": "A pre-built 'Best for you' candidate. kind=variation: a real item with published changes; kind=combo: several whole items.",
      "required": [
        "id",
        "name",
        "kind",
        "baseItemId",
        "components",
        "items",
        "nutrients",
        "tags",
        "itemCount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "variation",
            "combo"
          ]
        },
        "baseItemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentRef"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "modifierIds"
            ],
            "additionalProperties": false,
            "properties": {
              "itemId": {
                "$ref": "#/$defs/id"
              },
              "modifierIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "nutrients": {
          "$ref": "#/$defs/nutrients"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "itemCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "allergenKey": {
      "type": "string",
      "enum": [
        "celery",
        "gluten",
        "crustaceans",
        "eggs",
        "fish",
        "lupin",
        "milk",
        "molluscs",
        "mustard",
        "nuts",
        "peanuts",
        "sesame",
        "soya",
        "sulphites"
      ],
      "description": "One of the 14 allergens UK law requires to be declared ('gluten' = cereals containing gluten, 'nuts' = tree nuts, 'sulphites' = sulphur dioxide and sulphites)."
    },
    "allergens": {
      "type": "object",
      "required": [
        "contains",
        "mayContain"
      ],
      "additionalProperties": false,
      "description": "Copied from the chain's own allergen guide (docs/DATA.md 'Allergens'). Present only when the chain's guide was read completely.",
      "properties": {
        "contains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allergenKey"
          },
          "uniqueItems": true
        },
        "mayContain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allergenKey"
          },
          "uniqueItems": true,
          "description": "'May contain' / traces, only as the guide prints them; empty when none are printed (see allergenGuide.mayContainPublished)."
        },
        "cereals": {
          "type": "array",
          "items": {
            "enum": [
              "wheat",
              "rye",
              "barley",
              "oats",
              "spelt",
              "kamut"
            ]
          },
          "uniqueItems": true,
          "description": "Which cereals containing gluten, when the guide names them."
        },
        "nuts": {
          "type": "array",
          "items": {
            "enum": [
              "almond",
              "hazelnut",
              "walnut",
              "cashew",
              "pecan",
              "brazil nut",
              "pistachio",
              "macadamia"
            ]
          },
          "uniqueItems": true,
          "description": "Which tree nuts, when the guide names them."
        }
      }
    }
  }
}
